# tyche — smoke demo. Seeds the stream, shows determinism, and reminds callers
# this is NOT a CSPRNG. Library surface lives in src/rng.cyr (the [lib] bundle);
# this main is excluded from dist/tyche.cyr on purpose.
include "src/rng.cyr"

fn main() {
    alloc_init();
    println("tyche — deterministic statistical PRNG (NOT a CSPRNG; use sigil for crypto)");

    # Same seed must reproduce the same stream.
    rng_seed(42);
    var a = rng_u64();
    rng_seed(42);
    var b = rng_u64();
    if (a == b) { println("determinism: same seed -> same stream  [ok]"); }
    else { println("determinism: BROKEN"); return 1; }

    # Different seeds must diverge on the first draw.
    rng_seed(1); var s1 = rng_u64();
    rng_seed(2); var s2 = rng_u64();
    if (s1 != s2) { println("seed sensitivity: distinct seeds diverge  [ok]"); }
    else { println("seed sensitivity: BROKEN"); return 1; }

    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
